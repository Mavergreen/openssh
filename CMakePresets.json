{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": ["/usr/local/mavericks-shipyard/share/cmake/MavericksShipyard/mavericks-presets.json"],
  "configurePresets": [
    {
      "name": "native",
      "inherits": "mavericks-native",
      "displayName": "native -- build the OpenSSH updater on OS X 10.9",
      "cacheVariables": { "MAVERICKS_EXPECTED_MODE": "native" }
    },
    {
      "name": "cross",
      "inherits": "mavericks-cross",
      "displayName": "cross -- build the OpenSSH updater for 10.9 on a modern host",
      "cacheVariables": { "MAVERICKS_EXPECTED_MODE": "cross" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "cross",  "configurePreset": "cross" }
  ]
}
