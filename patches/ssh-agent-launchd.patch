+#ifdef __APPLE_LAUNCHD__
+	if (l_flag) {
+		/*
+		 * launchd check-in, and it MUST happen before closefrom().
+		 *
+		 * We use launch_msg(LAUNCH_KEY_CHECKIN), not the
+		 * launch_activate_socket() Apple's own tree now calls: that API is
+		 * undeclared in the 10.9 SDK's launch.h, so the compiler would be
+		 * guessing the prototype of an SPI on the platform this product
+		 * exists for. That choice dictates this placement. Apple runs its
+		 * check-in after closefrom(), which is correct for
+		 * launch_activate_socket() because that call reaches launchd over a
+		 * Mach port. launch_msg() instead talks to launchd over a socket
+		 * whose descriptor liblaunch caches, and closefrom() closes it --
+		 * after which every check-in fails with EPERM, the agent exits 1,
+		 * and launchd holds a socket no agent ever answers. Taking Apple's
+		 * placement together with the older API is what made the 10.5p1
+		 * port unreachable; each is right only with the other.
+		 *
+		 * We still purge inherited descriptors, just from above the
+		 * listeners launchd handed us rather than from stderr+1, which
+		 * would close the very sockets we just checked in for.
+		 */
+		launch_data_t resp, msg, tmp;
+		size_t listeners_i;
+		int listener_fd, max_fd = STDERR_FILENO;
+
+		msg = launch_data_new_string(LAUNCH_KEY_CHECKIN);
+		resp = launch_msg(msg);
+		if (NULL == resp) {
+			perror("launch_msg");
+			exit(1);
+		}
+		launch_data_free(msg);
+		switch (launch_data_get_type(resp)) {
+		case LAUNCH_DATA_ERRNO:
+			errno = launch_data_get_errno(resp);
+			perror("launch_msg response");
+			exit(1);
+		case LAUNCH_DATA_DICTIONARY:
+			break;
+		default:
+			fprintf(stderr, "launch_msg unknown response\n");
+			exit(1);
+		}
+		tmp = launch_data_dict_lookup(resp, LAUNCH_JOBKEY_SOCKETS);
+		if (NULL == tmp) {
+			fprintf(stderr, "no sockets\n");
+			exit(1);
+		}
+		tmp = launch_data_dict_lookup(tmp, "Listeners");
+		if (NULL == tmp) {
+			fprintf(stderr, "no known listeners\n");
+			exit(1);
+		}
+		for (listeners_i = 0;
+		    listeners_i < launch_data_array_get_count(tmp); listeners_i++) {
+			launch_data_t obj_at_ind =
+			    launch_data_array_get_index(tmp, listeners_i);
+			listener_fd = launch_data_get_fd(obj_at_ind);
+			if (listener_fd > max_fd)
+				max_fd = listener_fd;
+			new_socket(AUTH_SOCKET, listener_fd);
+		}
+		launch_data_free(resp);
+
+		closefrom(max_fd + 1);
+
+		goto skip2;
+	}
+#endif
 	closefrom(sock == -1 ? STDERR_FILENO + 1 : sock + 1);
 
