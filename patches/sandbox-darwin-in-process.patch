 	debug3_f("preparing Darwin sandbox");
 	box = xcalloc(1, sizeof(*box));
+#ifdef __APPLE_SANDBOX_IN_PROCESS__
+	/*
+	 * sandbox_init() compiles a string profile with libsandbox, which it
+	 * dlopen()s by path. ssh_sandbox_child() runs after the chroot to the
+	 * privsep directory, where that path does not exist, so it must
+	 * already be loaded. Security.framework loads it today; this makes the
+	 * dependency explicit, and a failure loud at the first login rather
+	 * than an "image not found" after the chroot.
+	 */
+	if (dlopen(SSH_SANDBOX_LIB, RTLD_NOW | RTLD_LOCAL) == NULL)
+		fatal_f("cannot load %s for the in-process sandbox: %s",
+		    SSH_SANDBOX_LIB, dlerror());
+#endif
 	return box;
 }
 
