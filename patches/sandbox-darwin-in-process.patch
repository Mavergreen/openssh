+#ifdef __APPLE_SANDBOX_IN_PROCESS__
+/*
+ * Applying the builtin kSBXProfilePureComputation (SANDBOX_NAMED) has the
+ * kernel fetch the profile from sandboxd, which launchd starts on demand:
+ * on 10.9, every boot's first login starts sandboxd, and a shutdown helper
+ * that waits for jobs still starting then waits ~19 s for it. This profile
+ * is compiled here, in this process, so nothing fetches it and no sandboxd
+ * starts. On the 20 operations measured on 10.9.5 it answers as the builtin
+ * does: both still allow socket(), so the rlimits below stay load-bearing.
+ */
+#define SSH_SANDBOX_PROFILE "(version 1) (deny default)"
+#define SSH_SANDBOX_LIB "/usr/lib/libsandbox.1.dylib"
+#endif
+
 struct ssh_sandbox *
