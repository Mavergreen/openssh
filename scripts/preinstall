#!/bin/sh
# Replacement pkg preinstall: back up the existing OpenSSH (binaries, configs, host keys) once,
# and migrate existing host keys into /usr/local/etc so a host's identity is preserved after we
# take over. Honors $ROOT for testing (default /). POSIX /bin/sh; runs on 10.9.
set -eu
ROOT="${ROOT:-/}"
BK="$ROOT/var/backups/vanilla-openssh"

BINS="usr/bin/ssh usr/bin/scp usr/bin/sftp usr/bin/ssh-add usr/bin/ssh-agent usr/bin/ssh-keygen usr/bin/ssh-keyscan usr/sbin/sshd usr/libexec/sftp-server usr/libexec/ssh-keysign usr/libexec/ssh-pkcs11-helper usr/libexec/ssh-sk-helper usr/libexec/sshd-session usr/libexec/sshd-keygen-wrapper"
CONFS="etc/ssh_config etc/sshd_config etc/moduli"

if [ ! -d "$BK" ]; then
  mkdir -p "$BK"
  for rel in $BINS $CONFS; do
    if [ -e "$ROOT/$rel" ] && [ ! -L "$ROOT/$rel" ]; then
      mkdir -p "$BK/$(dirname "$rel")"
      cp -p "$ROOT/$rel" "$BK/$rel"
    fi
  done
  for hk in "$ROOT"/etc/ssh_host_*; do
    [ -e "$hk" ] || continue
    mkdir -p "$BK/etc"; cp -p "$hk" "$BK/etc/"
  done
fi

# Migrate existing host keys into our prefix so identity is preserved.
mkdir -p "$ROOT/usr/local/etc"
for hk in "$ROOT"/etc/ssh_host_*; do
  [ -e "$hk" ] || continue
  base="$(basename "$hk")"
  [ -e "$ROOT/usr/local/etc/$base" ] || cp -p "$hk" "$ROOT/usr/local/etc/$base"
done

# ONE-TIME MIGRATION off the ModernMavericks identity (flag day 2026-09-22).
# DELETABLE once no pre-flag-day install survives (see shipyard SKILL.md "Consolidation backlog").
#
# This pkg's identifier moved from dev.modernmavericks.openssh.replace to
# dev.mavergreen.openssh.replace, and to Installer a different identifier is a different package: the
# old receipt would stay behind claiming openssh-mavericks-deactivate, which this pkg now owns. Forget
# it on Installer's target volume ($3); with none (a test run), nothing is done. Only the RECEIPT goes:
# the system paths above, the backup of the original OpenSSH and the migrated host keys carry no org
# name and stay exactly as they are, so the replaced sshd keeps running through the upgrade.
# Best-effort: never fail the install over a receipt.
if [ -n "${3:-}" ]; then
  pkgutil --volume "$3" --forget dev.modernmavericks.openssh.replace >/dev/null 2>&1 || true
fi
